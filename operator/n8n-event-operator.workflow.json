{
  "name": "Machine Factory — Event Operator",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 10
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 10 seconds",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -760,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL + '/rest/v1/rpc/operator_claim_next'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ p_worker: 'n8n-event-operator', p_lease_seconds: 180 }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "claim-command",
      "name": "Claim command",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -520,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const src = $json;\\nconst cmd = Array.isArray(src) ? src[0] : src;\\nif (!cmd || !cmd.id) return [];\\nreturn [{ json: cmd }];"
      },
      "id": "normalize-claim",
      "name": "Normalize claim",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -280,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.COMMUNITY_HUB_OPERATOR_URL}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ kind: 'operator.command', secret: $env.COMMUNITY_HUB_OPERATOR_SECRET, command: $json.command, approved: $json.payload?.approved === true, subjectId: $json.subject_id, payload: $json.payload || {} }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "dispatch-apps-script",
      "name": "Dispatch to Community Hub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -20,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const r = $json || {};\\nconst hasN8nError = !!(r.error && !r.ok && !r.waitingOwner);\\nlet state = 'error';\\nif (r.waitingOwner === true) state = 'waiting_owner';\\nelse if (r.ok === true) state = 'done';\\nconst error = state === 'error' ? String(r.error?.message || r.error || r.message || 'operator command failed') : null;\\nreturn [{json:{state,error,result:r,evidence:r.evidence ? [r.evidence] : []}}];"
      },
      "id": "classify-result",
      "name": "Classify result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL + '/rest/v1/rpc/operator_finish'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ p_id: $('Normalize claim').first().json.id, p_worker: 'n8n-event-operator', p_state: $json.state, p_result: $json.result, p_evidence: $json.evidence, p_error: $json.error }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "finish-command",
      "name": "Finish command",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ]
    }
  ],
  "connections": {
    "Every 10 seconds": {
      "main": [
        [
          {
            "node": "Claim command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim command": {
      "main": [
        [
          {
            "node": "Normalize claim",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize claim": {
      "main": [
        [
          {
            "node": "Dispatch to Community Hub",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatch to Community Hub": {
      "main": [
        [
          {
            "node": "Classify result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Classify result": {
      "main": [
        [
          {
            "node": "Finish command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveExecutionProgress": true
  },
  "active": false,
  "versionId": "b03d58c6-08a8-4d16-a0e2-80e206c10001",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}