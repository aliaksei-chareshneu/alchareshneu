{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Machine Factory Event Operator Command",
  "type": "object",
  "required": ["command", "target_worker", "payload"],
  "properties": {
    "command": {
      "enum": ["event.upsert", "event.publish", "event.verify", "event.cancel"]
    },
    "target_worker": { "const": "n8n-event-operator" },
    "subject_type": { "const": "event" },
    "subject_id": { "type": ["string", "null"] },
    "priority": { "type": "integer", "default": 100 },
    "idempotency_key": { "type": ["string", "null"] },
    "payload": {
      "type": "object",
      "properties": {
        "approved": { "type": "boolean", "default": false },
        "eventId": { "type": "string" },
        "event": {
          "type": "object",
          "properties": {
            "eventId": { "type": "string" },
            "community": { "enum": ["Brnowalkers", "Družina Moravy", "Shared"] },
            "category": { "type": "string" },
            "title": { "type": "string" },
            "startDateTime": { "type": "string" },
            "endDateTime": { "type": "string" },
            "locationName": { "type": "string" },
            "locationAddress": { "type": "string" },
            "priceCzk": { "type": "number" },
            "description": { "type": "string" },
            "imageFilename": { "type": "string" }
          }
        }
      }
    }
  }
}
