[Unit]
Description=IMPERION Zero-Cost Loopback CPU Compute Smoke
After=network.target
[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/usr/bin/python3 -I /opt/imperion/free_cpu_smoke.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
[Install]
WantedBy=multi-user.target
