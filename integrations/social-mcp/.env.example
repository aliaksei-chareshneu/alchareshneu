# Never commit live values or put secrets in account-wide instructions.
MCP_HOST=127.0.0.1
MCP_PORT=8788
# Existing Google Apps Script WEB APP /exec URL (deployment must include MCPBridge.gs).
MCP_BRIDGE_WEBAPP_URL=
# Same random >=32-character secret stored ONLY in Apps Script Properties: MCP_BRIDGE_SECRET
MCP_BRIDGE_SECRET=
PUBLISH_ENABLED=0
# For non-local deployment only: requires TLS reverse proxy, access control, host allowlist.
# MCP_CLIENT_TOKEN=
# MCP_ALLOWED_HOST=your-domain.example
