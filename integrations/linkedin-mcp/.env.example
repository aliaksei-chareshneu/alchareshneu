# Use https://your-real-host.example (no trailing slash or path). Do not commit secrets.
PUBLIC_BASE_URL=https://linkedin-mcp.your-domain.example
# DNS hostname without protocol, used by Caddy to provision a TLS certificate.
MCP_DOMAIN=linkedin-mcp.your-domain.example
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match the primary email provided by the LinkedIn OIDC userinfo endpoint.
LINKEDIN_OWNER_EMAIL=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_FERNET_KEY=
DB_PATH=/data/imperion_linkedin.sqlite
# Comma-separated exact Origin values allowed; leave empty unless needed.
ALLOWED_ORIGINS=

# Only these exact HTTPS hosts may receive DCR OAuth redirect codes (comma separated).
# Default is ChatGPT; never use wildcard domains or arbitrary user-provided URLs.
DCR_REDIRECT_HOSTS=chatgpt.com
