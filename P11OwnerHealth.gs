/** Owner-only, read-only live p11 safety and tariff release health. */
function drusP11OwnerHealth(){
  requireOwner_();
  const status=drusPaidRelease_();
  if(status.ok)throw new Error('P11_EXPECTED_PAID_LAUNCH_TO_REMAIN_CLOSED');
  const boot=getBootstrap();
  if(boot.bookingEnabled!==false||boot.bookingStatus!=='PAUSED'||
    !Array.isArray(boot.sessions)||boot.sessions.length!==0||
    Number(boot.tariff.trial)!==240||ensureSessions_()!==0)
    throw new Error('P11_LIVE_BOOTSTRAP_NOT_FAIL_CLOSED');
  const test={Session_ID:'P11-SYNTHETIC',Status:'OPEN',Capacity:100,Notes:'synthetic'};
  if(drusCapacityFromRow_(test,null)!==0)
    throw new Error('P11_SYNTHETIC_SESSION_UNSAFELY_BOOKABLE');
  const result={ok:true,mode:'OWNER_READ_ONLY_NO_SHEETS_WRITES',
    portalVersion:boot.version,paidBookingEnabled:false,
    paidCheckout:'PAUSED',novemberFirstVisitCZK:boot.tariff.trial,
    autoGeneratedSessions:0,unverifiedSessionCapacity:0,
    enquiryUrl:boot.enquiryUrl};
  console.log('P11_OWNER_READONLY_HEALTH_PASS '+JSON.stringify(result));
  return result;
}
